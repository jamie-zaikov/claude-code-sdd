.DS_Store

# Python bytecode
__pycache__/
*.pyc

**/.spec-state.json

# SDD per-feature scratch — data in, artifacts out; contents never committed
.specs/features/*/input-data/*
.specs/features/*/spec-memory/*
!.specs/features/*/input-data/README.md
!.specs/features/*/spec-memory/README.md

# Copilot instructions generated by the mermaid-ai-skills tool (sentinel-managed).
# Not tracked: an external tool rewrites these, so committing them imports another
# toolchain's generated content into a framework repo and produces unauthored churn.
.github/copilot-instructions.md
.github/instructions/
